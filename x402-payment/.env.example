# REQUIRED ONLY WHEN PURCHASING OR TOPPING UP CREDITS
# Export the private key for the MetaMask account that holds USDC on Base.
# Use a dedicated low-balance account. Never put your 12/24-word seed phrase here.
EVM_PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_PRIVATE_KEY

# ADDED AUTOMATICALLY AFTER A SUCCESSFUL PURCHASE
# This bearer key is secret. A normal lookup consumes one prepaid credit.
BUILTWITH_CREDIT_KEY=

# Safety controls. The client refuses any package quote other than 2,000 credits
# for exactly 99 USDC on Base to this recipient.
EXPECTED_PAY_TO=0x1937E2d648b8f07A03429AE35f28C4942A756C94
BUILTWITH_MCP_URL=https://api.builtwith.com/mcp
